<h1><%= @company.name %></h1>

<p>
  <strong>Email:</strong>
  <%= @company.email %>
</p>

<p>
  <strong>Website:</strong>
  <%= @company.website %>
</p>

<p>
  <strong>Description:</strong>
  <%= @company.description %>
</p>

<p>
  <strong>Location:</strong>
  <%= @company.location %>
</p>

<%= link_to "Back to Companies", companies_path %>
<%= link_to "Edit Company", edit_company_path(@company) %>
<%= button_to "Delete Company",
              @company,
              method: :delete,
              data: { turbo_confirm: "Are you sure?" } %>

<br><br>

<%= link_to "View Jobs", company_jobs_path(@company) %>

<%= link_to "Back to Companies", companies_path %>