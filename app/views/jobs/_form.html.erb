<%= form_with model: [@company, @job] do |form| %>

    <p>
      <%= form.label :title %><br>
      <%= form.text_field :title %>
    </p>
  
    <p>
      <%= form.label :description %><br>
      <%= form.text_area :description %>
    </p>
  
    <p>
      <%= form.label :salary %><br>
      <%= form.number_field :salary %>
    </p>
  
    <p>
      <%= form.label :location %><br>
      <%= form.text_field :location %>
    </p>
  
    <p>
      <%= form.label :employment_type %><br>
      <%= form.text_field :employment_type %>
    </p>
  
    <p>
      <%= form.label :experience_level %><br>
      <%= form.text_field :experience_level %>
    </p>
  
    <%= form.submit %>
  
  <% end %>