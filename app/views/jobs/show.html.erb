<h1><%= @job.title %></h1>

<p>
  <strong>Company:</strong>
  <%= @company.name %>
</p>

<p>
  <strong>Description:</strong>
  <%= @job.description %>
</p>

<p>
  <strong>Salary:</strong>
  <%= @job.salary %>
</p>

<p>
  <strong>Location:</strong>
  <%= @job.location %>
</p>

<p>
  <%= link_to "View Applicants",
      company_job_applicants_path(@company, @job) %>
</p>

<p>
  <%= link_to "Edit",
      edit_company_job_path(@company, @job) %>
</p>

<p>
  <%= link_to "Back",
      company_jobs_path(@company) %>
</p>